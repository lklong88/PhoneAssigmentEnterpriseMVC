<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Phone assignment management demonstration" />
    <title>@ViewData["Title"] · Phone Assignment Manager</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header"><div class="shell header-row">
    <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">PA</span><span>Phone Assignment <small>Management Console</small></span></a>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="Account" asp-action="Logout" method="post" asp-antiforgery="true"><button class="link-button" type="submit">Sign out</button></form>
    }
</div></header>
<main class="shell">@RenderBody()</main>
<footer class="shell footer">Demonstration application · Fictional data only · Not an official CU SoCal service</footer>
</body></html>
